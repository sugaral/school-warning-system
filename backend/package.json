{
  "name": "warnsys-backend",
  "version": "1.9.1",
  "description": "Academic warning system backend (NestJS + Prisma) - MVP skeleton",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:update-password": "ts-node prisma/update-password.ts",
    "db:init": "prisma generate && prisma migrate dev && ts-node prisma/seed.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "worker:notification": "ts-node src/workers/notification.worker.ts"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/bcrypt": "^1.10.9",
    "@prisma/client": "5.15.0",
    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^6.0.0",
    "cache-manager-ioredis-yet": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "dayjs": "^1.11.19",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.0",
    "minio": "^8.0.6",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.1.17",
    "@prisma/engines": "5.15.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "prisma": "5.15.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "path-to-regexp": "8.4.0"
  }
}
