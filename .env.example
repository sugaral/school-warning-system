TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=warnsys

# Docker service ports
MYSQL_PORT=3307
REDIS_PORT=6380
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
ADMINER_PORT=8081
BACKEND_PORT=3000
FRONTEND_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password
MYSQL_DATABASE=warnsys
MYSQL_USER=warnuser
MYSQL_PASSWORD=replace-with-strong-mysql-user-password

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=replace-with-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-minio-admin-user
MINIO_SECRET_KEY=replace-with-strong-minio-password
MINIO_BUCKET=warnsys-files
WARNING_QUEUE_SNAPSHOT_BUCKET=warnsys-warning-queue
WARNING_QUEUE_DLQ_BUCKET=warnsys-warning-dlq

# Backend runtime
DATABASE_URL=mysql://warnuser:replace-with-strong-mysql-user-password@mysql:3306/warnsys?authPlugins=mysql_native_password&charset=utf8mb4&connectionLimit=10
JWT_SECRET=replace-with-32-byte-random-secret
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:8080
ADMIN_FRONTEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
WEB_URL=http://localhost:8080
APP_URL=http://localhost:8080
VITE_ADMIN_APP_URL=http://localhost:8080

# Warning queue
WARNING_QUEUE_CONSUMER_ENABLED=true
WARNING_QUEUE_PENDING_TTL_SECONDS=900
WARNING_QUEUE_RETRY_LIMIT=5
WARNING_QUEUE_READ_COUNT=10
WARNING_QUEUE_CONSUMER_CONCURRENCY=4
WARNING_QUEUE_READ_BLOCK_MS=5000
WARNING_QUEUE_VISIBILITY_TIMEOUT_MS=30000
WARNING_QUEUE_INLINE_MAX_ITEMS=30
WARNING_QUEUE_INLINE_MAX_BYTES=8192
WARNING_QUEUE_STREAM_MAXLEN=10000
WARNING_QUEUE_DLQ_STREAM_MAXLEN=2000
WARNING_RECALC_CONCURRENCY=4
WARNING_SYNC_RECALC_CONCURRENCY=6
WARNING_STUDENT_LOCK_TTL_MS=120000
WARNING_TRANSACTION_TIMEOUT_MS=30000
WARNING_TRANSACTION_MAX_WAIT_MS=10000

# Optional integrations
WECHAT_MINIAPP_APP_ID=your_wechat_app_id
WECHAT_MINIAPP_APP_SECRET=your_wechat_app_secret
WX_APP_ID=your_wechat_app_id
WX_APP_SECRET=your_wechat_app_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
