# Database
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=warnsys
MYSQL_USER=warnuser
MYSQL_PASSWORD=changeme_user_password
MYSQL_PORT=3307
DATABASE_URL=mysql://warnuser:changeme_user_password@mysql:3306/warnsys

# Redis
REDIS_PORT=6380
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_password
MINIO_BUCKET=warnsys-files
WARNING_QUEUE_SNAPSHOT_BUCKET=warnsys-warning-queue
WARNING_QUEUE_DLQ_BUCKET=warnsys-warning-dlq

# Adminer
ADMINER_PORT=8081

# Backend
BACKEND_PORT=3000
NODE_ENV=production
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=http://localhost:8080
ADMIN_FRONTEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
WEB_URL=http://localhost:8080
APP_URL=http://localhost:8080
VITE_ADMIN_APP_URL=http://localhost:8080

# Warning queue tuning
WARNING_QUEUE_CONSUMER_ENABLED=true
WARNING_QUEUE_PENDING_TTL_SECONDS=900
WARNING_QUEUE_RETRY_LIMIT=5
WARNING_QUEUE_READ_COUNT=10
WARNING_QUEUE_CONSUMER_CONCURRENCY=4
WARNING_QUEUE_READ_BLOCK_MS=5000
WARNING_QUEUE_VISIBILITY_TIMEOUT_MS=30000
WARNING_QUEUE_INLINE_MAX_ITEMS=30
WARNING_QUEUE_INLINE_MAX_BYTES=8192
WARNING_QUEUE_STREAM_MAXLEN=10000
WARNING_QUEUE_DLQ_STREAM_MAXLEN=2000
WARNING_RECALC_CONCURRENCY=12
WARNING_SYNC_RECALC_CONCURRENCY=12
WARNING_STUDENT_LOCK_TTL_MS=120000
WARNING_TRANSACTION_TIMEOUT_MS=30000
WARNING_TRANSACTION_MAX_WAIT_MS=10000

# ============================================================
# P0-3 独立 Worker：API 与后台任务的队列消费权分离
# ------------------------------------------------------------
# 通知任务队列（notification_jobs）与 Redis Streams 预警队列
# 都只在 worker 容器消费，API 容器不消费，避免重复处理。
# 回退到「单容器模式」：把 *_API 改为 true，*_WORKER 改为 false。
# ============================================================
WARNING_QUEUE_CONSUMER_ENABLED_API=false
WARNING_QUEUE_CONSUMER_ENABLED_WORKER=true
NOTIFICATION_DISPATCH_ENABLED_API=false
NOTIFICATION_DISPATCH_ENABLED_WORKER=true
NOTIFICATION_WORKER_INTERVAL_MS=30000
NOTIFICATION_JOB_BATCH_SIZE=8

# migrate 服务执行完 db push 后是否自动跑 seed
SEED_ON_MIGRATE=true

# WeChat
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WX_APP_ID=
WX_APP_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Frontend
FRONTEND_PORT=8080

# Timezone
TZ=Asia/Shanghai

# Test
TEST_PASSWORD=changeme_test_password
