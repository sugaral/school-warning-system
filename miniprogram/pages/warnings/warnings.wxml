<view class="page">
  <!-- 筛选 -->
  <view class="filters">
    <view class="filter-item {{level === '' ? 'active' : ''}}" bindtap="onFilter" data-key="level" data-value="">全部等级</view>
    <view class="filter-item {{level === 'yellow' ? 'active' : ''}}" bindtap="onFilter" data-key="level" data-value="yellow">黄色</view>
    <view class="filter-item {{level === 'orange' ? 'active' : ''}}" bindtap="onFilter" data-key="level" data-value="orange">橙色</view>
    <view class="filter-item {{level === 'red' ? 'active' : ''}}" bindtap="onFilter" data-key="level" data-value="red">红色</view>
    <view class="filter-item {{level === 'severe' ? 'active' : ''}}" bindtap="onFilter" data-key="level" data-value="severe">严重</view>
  </view>
  <view class="filters">
    <view class="filter-item {{status === '' ? 'active' : ''}}" bindtap="onFilter" data-key="status" data-value="">全部状态</view>
    <view class="filter-item {{status === 'open' ? 'active' : ''}}" bindtap="onFilter" data-key="status" data-value="open">待确认</view>
    <view class="filter-item {{status === 'acknowledged' ? 'active' : ''}}" bindtap="onFilter" data-key="status" data-value="acknowledged">已确认</view>
    <view class="filter-item {{status === 'closed' ? 'active' : ''}}" bindtap="onFilter" data-key="status" data-value="closed">已关闭</view>
  </view>

  <!-- 列表 -->
  <view class="warn-item card" wx:for="{{items}}" wx:key="index" bindtap="goDetail" data-id="{{item.id}}">
    <view class="warn-head">
      <text class="badge badge-{{item.level}}">{{item.levelText}}</text>
      <text class="warn-metric">{{item.metricText}}</text>
      <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
    </view>
    <view class="warn-summary">{{item.trigger_summary || '—'}}</view>
    <view class="warn-meta">
      <text>{{item.windowText}} · {{item.periodText}}</text>
      <text>{{item.createdText}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && items.length === 0}}">暂无预警记录</view>
  <view class="load-more" wx:if="{{hasMore && items.length > 0}}" bindtap="loadMore">点击加载更多</view>
  <view class="load-more" wx:if="{{loading}}">加载中...</view>
</view>
