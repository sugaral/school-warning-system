.course-bar {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(56, 49, 57, 0.07);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.course-label {
  font-size: 25rpx;
  color: #6f6875;
}
.course-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #e4f4ea;
  color: #3f8a5d;
  font-size: 24rpx;
  font-weight: 600;
}
.warn-item {
  padding: 28rpx;
}
.warn-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.warn-metric {
  font-size: 29rpx;
  font-weight: 700;
  color: #383139;
  flex: 1;
}
.warn-course {
  font-size: 24rpx;
  color: #3f8a5d;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.warn-summary {
  font-size: 27rpx;
  color: #48404b;
  line-height: 1.6;
  margin-bottom: 14rpx;
}
.warn-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8f8896;
}
.warn-actions {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(56, 49, 57, 0.07);
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}
