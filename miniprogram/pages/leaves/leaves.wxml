<view class="page">
  <view class="page-toolbar">
    <view>
      <view class="page-heading">请假申请</view>
      <view class="page-sub">可提交事假、病假、公假并上传证明图片</view>
    </view>
    <button class="btn btn-sm" bindtap="goCreate">+ 发起请假</button>
  </view>

  <block wx:if="{{items.length > 0}}">
    <view class="card leave-card" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="leave-head">
        <text class="tag tag-info">{{item.leave_type}}</text>
        <text class="leave-time">{{item.startText}} 至 {{item.endText}}</text>
        <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="leave-reason">{{item.reason || '-'}}</view>
      <view class="leave-foot">
        <text wx:if="{{item.proofCount > 0}}" class="proof-chip">含 {{item.proofCount}} 张证明图</text>
        <text wx:else class="muted-meta">未附证明图片</text>
        <text class="muted-meta">{{item.createdText}}</text>
      </view>
      <view class="reject-note" wx:if="{{item.reject_reason}}">
        审批说明：{{item.reject_reason}}
      </view>
    </view>
  </block>

  <view class="card empty" wx:else>
    {{loading ? '正在加载请假记录...' : '暂无请假记录，点击右上角即可发起请假'}}
  </view>
</view>
