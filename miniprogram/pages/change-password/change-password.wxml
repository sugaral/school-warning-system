<view class="page">
  <view class="card card-amber" wx:if="{{!email}}" bindtap="goBindEmail">
    <view class="card-title" style="margin-bottom:8rpx">
      <text style="color:#a16207">当前账号尚未绑定有效邮箱</text>
      <text class="tag tag-warn">去绑定</text>
    </view>
    <view class="hint-text" style="margin-top:0;color:#854d0e">
      为保障学生账号安全，修改登录密码需通过绑定邮箱验证码核验。点击立即前往绑定邮箱。
    </view>
  </view>

  <view class="card" wx:else>
    <view class="card-title">通过绑定邮箱验证改密</view>
    <view class="row">
      <text class="row-label">绑定邮箱</text>
      <text class="row-value">{{email}}</text>
    </view>

    <view class="form-item">
      <text class="form-label form-required">邮箱验证码</text>
      <view class="code-row">
        <input
          class="form-input"
          type="number"
          placeholder="请输入 6 位验证码"
          value="{{code}}"
          bindinput="onInput"
          data-field="code"
          maxlength="8"
        />
        <button class="code-btn" bindtap="onSendCode" disabled="{{sending || cooldown > 0}}">
          {{cooldown > 0 ? cooldown + 's' : '发送验证码'}}
        </button>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label form-required">新密码</text>
      <input
        class="form-input"
        password
        placeholder="至少 8 位，包含字母和数字等两类字符"
        value="{{newPassword}}"
        bindinput="onInput"
        data-field="newPassword"
        maxlength="64"
      />
    </view>

    <view class="form-item">
      <text class="form-label form-required">确认新密码</text>
      <input
        class="form-input"
        password
        placeholder="请再次输入新密码"
        value="{{confirmPassword}}"
        bindinput="onInput"
        data-field="confirmPassword"
        maxlength="64"
      />
    </view>

    <button class="btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
      确认修改密码
    </button>
  </view>
</view>
