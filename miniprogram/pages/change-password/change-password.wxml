<view class="page">
  <view class="card">
    <view class="form-item">
      <text class="form-label form-required">当前密码</text>
      <input class="form-input" password placeholder="" value="{{form.old_password}}" bindinput="onInput" data-key="old_password" />
    </view>
    <view class="form-item">
      <text class="form-label form-required">新密码</text>
      <input class="form-input" password placeholder="至少 8 位，含字母与数字" value="{{form.new_password}}" bindinput="onInput" data-key="new_password" />
    </view>
    <view class="form-item">
      <text class="form-label form-required">确认新密码</text>
      <input class="form-input" password placeholder="" value="{{form.confirm_password}}" bindinput="onInput" data-key="confirm_password" />
    </view>
    <button class="btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交</button>
  </view>
</view>
