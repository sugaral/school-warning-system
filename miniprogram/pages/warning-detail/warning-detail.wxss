.warn-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.warn-metric {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
}
.summary {
  font-size: 30rpx;
  line-height: 1.7;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.rule-text {
  font-size: 27rpx;
  line-height: 1.8;
  color: #595959;
}
.confirmed-tip {
  text-align: center;
  color: #8c8c8c;
  font-size: 27rpx;
  padding: 40rpx 0;
}
