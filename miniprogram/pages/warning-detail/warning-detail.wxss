.warn-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.warn-metric {
  font-size: 32rpx;
  font-weight: 700;
  color: #383139;
  flex: 1;
}
.summary {
  font-size: 29rpx;
  line-height: 1.65;
  color: #383139;
  padding: 22rpx 24rpx;
  background: #f5f8f6;
  border-radius: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: inset 2rpx 2rpx 6rpx rgba(56, 49, 57, 0.06);
}
.rule-text {
  font-size: 26rpx;
  line-height: 1.75;
  color: #48404b;
}
.confirmed-tip {
  text-align: center;
  color: #6f6875;
  font-size: 26rpx;
  padding: 36rpx 0;
}
