.inbox-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.msg-card {
  padding: 26rpx 28rpx;
}
.msg-unread {
  border-left: 8rpx solid #4f9e6f;
}
.msg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.msg-time {
  flex: 1;
  font-size: 22rpx;
  color: #8f8896;
}
.notice-title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 700;
  color: #383139;
}
.msg-body {
  font-size: 27rpx;
  color: #48404b;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.msg-foot {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8f8896;
}
