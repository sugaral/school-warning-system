.photo-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.photo-thumb,
.photo-placeholder {
  width: 120rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: #edf9f1;
}
.photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8f8896;
  font-size: 22rpx;
  border: 2rpx dashed rgba(79, 158, 111, 0.35);
}

.cc-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(56, 49, 57, 0.07);
}
.cc-item:last-child {
  border-bottom: none;
}
.cc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.cc-route {
  font-size: 28rpx;
  font-weight: 700;
  color: #383139;
  flex: 1;
}
.cc-meta {
  font-size: 23rpx;
  color: #6f6875;
  margin-bottom: 8rpx;
}
.cc-reason {
  font-size: 26rpx;
  color: #48404b;
  line-height: 1.5;
  margin-bottom: 10rpx;
}
.cc-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cc-time {
  font-size: 22rpx;
  color: #8f8896;
}
