<view class="page">
  <view class="segmented">
    <view class="seg-item {{activeTab === 'basic' ? 'active' : ''}}" bindtap="switchTab" data-tab="basic">基础资料</view>
    <view class="seg-item {{activeTab === 'security' ? 'active' : ''}}" bindtap="switchTab" data-tab="security">手机/邮箱</view>
    <view class="seg-item {{activeTab === 'class' ? 'active' : ''}}" bindtap="switchTab" data-tab="class">换班申请</view>
  </view>

  <!-- 页签 1：基础资料 -->
  <block wx:if="{{activeTab === 'basic'}}">
    <view class="card">
      <view class="card-title">学籍只读信息</view>
      <view class="row"><text class="row-label">学号</text><text class="row-value">{{profile.student_no || '-'}}</text></view>
      <view class="row"><text class="row-label">姓名</text><text class="row-value">{{profile.name || '-'}}</text></view>
      <view class="row"><text class="row-label">学院 / 班级</text><text class="row-value">{{profile.org_name || '-'}} · {{profile.class_name || '-'}}</text></view>
      <view class="row"><text class="row-label">专业 / 入学年份</text><text class="row-value">{{profile.major || '-'}} {{profile.enroll_year ? '(' + profile.enroll_year + '级)' : ''}}</text></view>
    </view>

    <view class="card">
      <view class="card-title">个人资料维护</view>

      <view class="form-item">
        <text class="form-label">学生证件照</text>
        <view class="photo-row">
          <image wx:if="{{photoUrl}}" class="photo-thumb" src="{{photoUrl}}" mode="aspectFill" bindtap="onPreviewPhoto" />
          <view wx:else class="photo-placeholder">未上传</view>
          <button class="btn btn-ghost btn-sm" bindtap="onUploadPhoto">
            {{photoUrl ? '更换证件照' : '上传证件照'}}
          </button>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">性别</text>
        <view class="filters" style="margin-bottom:0">
          <view class="filter-item {{form.gender === 'male' ? 'active' : ''}}" bindtap="selectGender" data-gender="male">男</view>
          <view class="filter-item {{form.gender === 'female' ? 'active' : ''}}" bindtap="selectGender" data-gender="female">女</view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">班级职务</text>
        <input
          class="form-input"
          placeholder="例如：班长、学习委员（选填）"
          value="{{form.student_position}}"
          bindinput="onBasicInput"
          data-key="student_position"
          maxlength="32"
        />
      </view>

      <view class="form-item">
        <text class="form-label">紧急联系人</text>
        <input
          class="form-input"
          placeholder="家长或监护人姓名"
          value="{{form.emergency_contact_name}}"
          bindinput="onBasicInput"
          data-key="emergency_contact_name"
          maxlength="64"
        />
      </view>

      <view class="form-item">
        <text class="form-label">紧急联系电话</text>
        <input
          class="form-input"
          type="number"
          placeholder="11 位手机号"
          value="{{form.emergency_contact_mobile}}"
          bindinput="onBasicInput"
          data-key="emergency_contact_mobile"
          maxlength="11"
        />
      </view>

      <view class="hint-text">紧急联系人用于红色/严重预警升级时通知家长，请务必保持准确。</view>
      <button class="btn" bindtap="onSaveBasic" loading="{{savingBasic}}" disabled="{{savingBasic}}">保存基础资料</button>
    </view>
  </block>

  <!-- 页签 2：手机与邮箱验证码绑定 -->
  <block wx:elif="{{activeTab === 'security'}}">
    <view class="card">
      <view class="card-title">
        <text>邮箱绑定与更换</text>
        <text class="tag {{profile.email ? 'tag-success' : 'tag-warn'}}">{{profile.email ? '已绑定' : '未绑定'}}</text>
      </view>
      <view class="hint-text" style="margin-top:0;margin-bottom:16rpx">
        当前邮箱：{{profile.email || '尚未绑定（绑定后可用于改密和换绑手机校验）'}}
      </view>

      <view class="form-item">
        <text class="form-label form-required">新邮箱地址</text>
        <view class="code-row">
          <input
            class="form-input"
            placeholder="请输入邮箱"
            value="{{emailForm.email}}"
            bindinput="onEmailInput"
            data-key="email"
          />
          <button class="code-btn" bindtap="onSendEmailCode" disabled="{{emailForm.cooldown > 0 || bindingEmail}}">
            {{emailForm.cooldown > 0 ? emailForm.cooldown + 's' : '发验证码'}}
          </button>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label form-required">邮箱验证码</text>
        <input
          class="form-input"
          type="number"
          placeholder="输入收到的 6 位验证码"
          value="{{emailForm.code}}"
          bindinput="onEmailInput"
          data-key="code"
          maxlength="8"
        />
      </view>

      <button class="btn" bindtap="onBindEmail" loading="{{bindingEmail}}" disabled="{{bindingEmail}}">确认绑定邮箱</button>
    </view>

    <view class="card">
      <view class="card-title">
        <text>手机号绑定与更新</text>
        <text class="tag {{profile.mobile ? 'tag-success' : 'tag-warn'}}">{{profile.mobile ? '已绑定' : '未绑定'}}</text>
      </view>
      <view class="hint-text" style="margin-top:0;margin-bottom:16rpx">
        当前手机：{{profile.mobile || '尚未绑定（首次可直接绑定；更换已绑手机号需先做邮箱校验）'}}
      </view>

      <view class="form-item">
        <text class="form-label form-required">手机号</text>
        <input
          class="form-input"
          type="number"
          placeholder="请输入 11 位大陆手机号"
          value="{{phoneForm.mobile}}"
          bindinput="onPhoneInput"
          data-key="mobile"
          maxlength="11"
        />
      </view>

      <block wx:if="{{profile.mobile && phoneForm.mobile !== profile.mobile}}">
        <view class="form-item">
          <text class="form-label form-required">邮箱身份核验码（将发至 {{profile.email || '未绑定邮箱'}}）</text>
          <view class="code-row">
            <input
              class="form-input"
              type="number"
              placeholder="输入 6 位核验码"
              value="{{phoneForm.code}}"
              bindinput="onPhoneInput"
              data-key="code"
              maxlength="8"
            />
            <button class="code-btn" bindtap="onSendPhoneVerifyCode" disabled="{{phoneForm.cooldown > 0 || bindingPhone}}">
              {{phoneForm.cooldown > 0 ? phoneForm.cooldown + 's' : '发核验码'}}
            </button>
          </view>
        </view>
      </block>

      <button class="btn" bindtap="onBindPhone" loading="{{bindingPhone}}" disabled="{{bindingPhone}}">提交手机号更新</button>
    </view>
  </block>

  <!-- 页签 3：换班申请与记录 -->
  <block wx:else>
    <view class="card">
      <view class="card-title">提交换班申请</view>
      <view class="row"><text class="row-label">当前班级</text><text class="row-value">{{profile.class_name || '未绑定'}}</text></view>
      <view class="row"><text class="row-label">审核班主任</text><text class="row-value">{{profile.head_teacher_name || '当前班级未绑定班主任'}}</text></view>

      <view class="hint-text" style="color:#c04a52" wx:if="{{!profile.head_teacher_user_id}}">
        当前班级尚未绑定班主任，暂无法在线发起换班申请。
      </view>

      <view class="form-item">
        <text class="form-label form-required">目标班级</text>
        <picker mode="selector" range="{{classOptions}}" range-key="displayLabel" value="{{classIndex >= 0 ? classIndex : 0}}" bindchange="onTargetClassChange">
          <view class="form-picker">
            <text>{{classOptions[classIndex] ? classOptions[classIndex].displayLabel : '请选择目标班级'}}</text>
            <text class="row-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label form-required">换班原因</text>
        <textarea
          class="form-textarea"
          placeholder="请说明申请更换班级的原因"
          value="{{classChangeForm.reason}}"
          bindinput="onClassReasonInput"
          maxlength="200"
        />
      </view>

      <view class="form-item">
        <text class="form-label">佐证图片（选填，最多 6 张）</text>
        <view class="image-grid">
          <view class="image-wrap" wx:for="{{evidenceImages}}" wx:key="id">
            <image class="image-item" src="{{item.tempPath}}" mode="aspectFill" />
            <view class="image-del" catchtap="onRemoveEvidence" data-index="{{index}}">×</view>
          </view>
          <view class="image-add" wx:if="{{evidenceImages.length < 6}}" bindtap="onChooseEvidence">
            <text>+</text>
            <text class="image-add-tip">{{evidenceImages.length}}/6</text>
          </view>
        </view>
      </view>

      <button
        class="btn"
        bindtap="onSubmitClassChange"
        loading="{{submittingClassChange}}"
        disabled="{{submittingClassChange || !profile.head_teacher_user_id}}"
      >
        提交换班申请
      </button>
    </view>

    <view class="card">
      <view class="card-title">换班申请记录</view>
      <block wx:if="{{classChangeList.length > 0}}">
        <view class="cc-item" wx:for="{{classChangeList}}" wx:key="id">
          <view class="cc-head">
            <text class="cc-route">{{item.current_class_name || '原班级'}} → {{item.target_class_name}}</text>
            <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="cc-meta">目标学院：{{item.target_org_name || '-'}} · 审核班主任：{{item.requested_head_teacher_name || '-'}}</view>
          <view class="cc-reason">原因：{{item.reason}}</view>
          <view class="cc-foot">
            <text class="cc-time">{{item.createdText}}</text>
            <text
              wx:if="{{item.evidence_file_ids && item.evidence_file_ids.length > 0}}"
              class="card-link"
              bindtap="onPreviewRecordEvidence"
              data-ids="{{item.evidence_file_ids}}"
            >
              查看 {{item.evidence_file_ids.length}} 张佐证图 >
            </text>
          </view>
          <view class="error-box" style="margin-top:12rpx" wx:if="{{item.reject_reason}}">
            驳回说明：{{item.reject_reason}}
          </view>
        </view>
      </block>
      <view class="empty" wx:else style="padding:40rpx 0">暂无换班申请记录</view>
    </view>
  </block>
</view>
