<view class="page page-has-tabbar">
  <view class="card card-amber" wx:if="{{unboundError}}" bindtap="goBindClass">
    <view class="card-title" style="margin-bottom:6rpx">
      <text style="color:#a16207">您尚未绑定班级，暂无法加载本班课表</text>
      <text class="tag tag-warn">去绑定</text>
    </view>
    <view class="hint-text" style="margin-top:0">点击立即选择学院与班级</view>
  </view>

  <block wx:else>
    <!-- 学期与周次筛选 -->
    <view class="card">
      <view class="card-title" style="margin-bottom:14rpx">
        <text>{{contextLabel || '本班课表'}}</text>
        <text class="tag tag-info">{{selectedTerm}}</text>
      </view>
      <view class="picker-row">
        <picker mode="selector" range="{{termOptions}}" value="{{termIndex}}" bindchange="onTermChange" class="picker-box">
          <view class="form-picker">
            <text>{{selectedTerm}}</text>
            <text class="row-arrow">▼</text>
          </view>
        </picker>
        <picker mode="selector" range="{{weekOptions}}" range-key="label" value="{{weekIndex}}" bindchange="onWeekChange" class="picker-box">
          <view class="form-picker">
            <text>{{weekOptions[weekIndex] ? weekOptions[weekIndex].label : '全部周次'}}</text>
            <text class="row-arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 星期气泡玻璃平滑切换 -->
    <view class="glass-track glass-track-xs">
      <view
        class="glass-bubble"
        style="width: calc((100% - 12rpx) / 8); transform: translateX({{activeWeekday * 100}}%);"
      ></view>
      <view
        wx:for="{{weekdays}}"
        wx:key="key"
        class="glass-item {{activeWeekday === item.key ? 'active' : ''}}"
        bindtap="onWeekdaySelect"
        data-key="{{item.key}}"
      >
        {{item.label}}
      </view>
    </view>

    <!-- 按星期分组展示课程 -->
    <block wx:if="{{groupedDays.length > 0}}">
      <view class="card" wx:for="{{groupedDays}}" wx:key="weekdayKey">
        <view class="card-title">
          <text>{{item.weekdayLabel}}</text>
          <text class="hint-text" style="margin-top:0">共 {{item.items.length}} 节</text>
        </view>
        <view class="sched-item" wx:for="{{item.items}}" wx:for-item="course" wx:key="id">
          <view class="sched-time-col">
            <view class="sched-time">{{course.timeRange}}</view>
            <view class="sched-date">{{course.weekLabel}} · {{course.dateLabel}}</view>
          </view>
          <view class="sched-info-col">
            <view class="sched-name">{{course.course_name}}</view>
            <view class="sched-meta">
              教师：{{course.teacher_name || '未分配'}} · 班级：{{course.class_name || contextLabel}}
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="card empty" wx:else>
      {{loading ? '正在加载课表...' : '当前学期/周次下暂无排课数据'}}
    </view>
  </block>
</view>
