<view class="page">
  <!-- 学生信息 -->
  <view class="hero">
    <view class="hero-name">{{student.name || '同学'}}</view>
    <view class="hero-sub">{{student.student_no ? '学号 ' + student.student_no : ''}} {{student.class_name ? '· ' + student.class_name : ''}}</view>
  </view>

  <!-- 今日概览：考勤 / 作业 -->
  <view class="card">
    <view class="card-title">
      <text>今日概览</text>
      <text style="font-size:24rpx;color:#8c8c8c">{{today.date || ''}}</text>
    </view>
    <view class="stat-grid">
      <view class="stat">
        <view class="stat-value">{{today.attendanceText || '-'}}</view>
        <view class="stat-label">考勤</view>
      </view>
      <view class="stat">
        <view class="stat-value">{{today.homeworkText || '-'}}</view>
        <view class="stat-label">作业</view>
      </view>
      <view class="stat">
        <view class="stat-value">{{today.courseCount || 0}}</view>
        <view class="stat-label">今日课程</view>
      </view>
    </view>
  </view>

  <!-- 当前预警数 -->
  <view class="card" bindtap="goWarnings">
    <view class="card-title">
      <text>我的预警</text>
      <text style="font-size:24rpx;color:#1677ff">查看全部 ></text>
    </view>
    <view class="stat-grid">
      <view class="stat">
        <view class="stat-value" style="color:#faad14">{{warnStats.today || 0}}</view>
        <view class="stat-label">今日</view>
      </view>
      <view class="stat">
        <view class="stat-value" style="color:#fa8c16">{{warnStats.week || 0}}</view>
        <view class="stat-label">本周</view>
      </view>
      <view class="stat">
        <view class="stat-value" style="color:#f5222d">{{warnStats.month || 0}}</view>
        <view class="stat-label">本月</view>
      </view>
      <view class="stat">
        <view class="stat-value" style="color:#8c8c8c">{{warnStats.unconfirmed || 0}}</view>
        <view class="stat-label">未确认</view>
      </view>
    </view>
    <view class="level-line" wx:if="{{warnStats.highestLevel}}">
      当前最高等级：<text class="badge badge-{{warnStats.highestLevel}}">{{warnStats.highestLevelText}}</text>
    </view>
  </view>

  <!-- 近 7 天趋势 -->
  <view class="card">
    <view class="card-title">近 7 天考勤趋势</view>
    <view class="trend">
      <view class="trend-item" wx:for="{{trend}}" wx:key="index">
        <view class="trend-bar {{item.attendance === 'on_time' ? 'ok' : (item.attendance === 'absent' ? 'bad' : 'warn')}}"
              style="height:{{item.height}}rpx"></view>
        <view class="trend-label">{{item.date}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{trend.length === 0}}" style="padding:40rpx 0">暂无考勤记录</view>
  </view>

  <!-- 快捷入口 -->
  <view class="card">
    <view class="card-title">快捷操作</view>
    <view class="quick">
      <view class="quick-item" bindtap="goCheckin"><text>扫码签到</text></view>
      <view class="quick-item" bindtap="goLeave"><text>请假申请</text></view>
      <view class="quick-item" bindtap="goSummaries"><text>我的汇总</text></view>
      <view class="quick-item" bindtap="goNotifications"><text>班级通知</text></view>
    </view>
  </view>

  <!-- 通知到达/确认状态 -->
  <view class="card" wx:if="{{notifyStat}}">
    <view class="card-title">通知到达与确认</view>
    <view class="row"><text class="row-label">已送达</text><text class="row-value">{{notifyStat.success}}</text></view>
    <view class="row"><text class="row-label">已确认</text><text class="row-value">{{notifyStat.acknowledged}}</text></view>
    <view class="row"><text class="row-label">未确认</text><text class="row-value" style="color:#fa8c16">{{notifyStat.pending}}</text></view>
  </view>
</view>
