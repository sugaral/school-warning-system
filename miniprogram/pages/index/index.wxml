<view class="page page-has-tabbar">
  <!-- 学生信息软陶英雄卡片 -->
  <view class="hero-clay">
    <view class="hero-top">
      <view>
        <view class="hero-name">{{student.name || '同学'}}，你好</view>
        <view class="hero-sub">
          学号 {{student.student_no || '-'}}
        </view>
        <view class="hero-org">
          {{student.org_name && student.org_name !== '未绑定' ? student.org_name + ' · ' : ''}}{{student.class_name || '未绑定班级'}}
        </view>
      </view>
      <view class="hero-pill" bindtap="goCheckin">
        扫码签到
      </view>
    </view>
  </view>

  <!-- 未绑定班级提醒 -->
  <view class="card card-amber" wx:if="{{!isBound}}" bindtap="goBindClass">
    <view class="card-title" style="margin-bottom:8rpx">
      <text style="color:#a16207">当前尚未绑定学院与班级</text>
      <text class="tag tag-warn">立即绑定</text>
    </view>
    <view class="hint-text" style="margin-top:0;color:#854d0e">
      绑定后即可查看班主任/授课老师，并发起请假与接收站内预警消息。
    </view>
  </view>

  <!-- 未读站内消息提醒 -->
  <view class="card card-tint" bindtap="goNotifications">
    <view class="card-title" style="margin-bottom:14rpx">
      <text>消息中心</text>
      <view class="tag {{messageSummary.totalUnread > 0 ? 'tag-danger' : 'tag-success'}}">{{messageSummary.totalUnread > 0 ? messageSummary.totalUnread + ' 条未读' : '全部已读'}}</view>
    </view>
    <view class="msg-bar">
      <view class="msg-chip">
        <text class="msg-chip-label">个人站内消息</text>
        <text class="msg-chip-num">{{messageSummary.inboxUnread}}</text>
      </view>
    </view>
  </view>

  <!-- 我的预警 -->
  <view class="card" bindtap="goWarnings">
    <view class="card-title">
      <text>我的预警</text>
      <text class="card-link">查看全部 ></text>
    </view>
    <view class="stat-grid">
      <view class="stat-tile">
        <view class="stat-value">{{warnStats.total}}</view>
        <view class="stat-label">总预警</view>
      </view>
      <view class="stat-tile stat-tile-warn">
        <view class="stat-value" style="color:#b7791f">{{warnStats.pending}}</view>
        <view class="stat-label">待确认</view>
      </view>
      <view class="stat-tile stat-tile-green">
        <view class="stat-value" style="color:#3f8a5d">{{warnStats.processing}}</view>
        <view class="stat-label">已确认</view>
      </view>
    </view>
    <view class="warn-footer">
      <text class="hint-text" style="margin-top:0">本周异常 {{warnStats.week}} 次 · 本月异常 {{warnStats.month}} 次</text>
      <text class="badge badge-{{warnStats.highestLevel}}" wx:if="{{warnStats.highestLevel}}">{{warnStats.highestLevelText}}</text>
    </view>
  </view>

  <!-- 近 7 天考勤趋势 -->
  <view class="card">
    <view class="card-title">
      <text>近 7 天考勤趋势</text>
      <text class="card-link" bindtap="goAttendance">详情 ></text>
    </view>
    <view class="trend" wx:if="{{trend.length > 0}}">
      <view class="trend-item" wx:for="{{trend}}" wx:key="index">
        <view
          class="trend-bar {{item.attendance === 'on_time' ? 'ok' : (item.attendance === 'absent' ? 'bad' : (item.attendance === 'unknown' ? 'none' : 'warn'))}}"
          style="height:{{item.height}}rpx"
        ></view>
        <view class="trend-label">{{item.date}}</view>
      </view>
    </view>
    <view class="empty" wx:else style="padding:36rpx 0">暂无考勤记录</view>
  </view>
</view>
