<view class="page">
  <view class="card">
    <view class="card-title">周考勤与作业汇总</view>
    <block wx:for="{{weekly}}" wx:key="week_start">
      <view class="period-head">{{item.label}}</view>
      <view class="stat-grid">
        <view class="stat-tile stat-tile-warn">
          <view class="stat-value" style="color:#b7791f">{{item.late_count}}</view>
          <view class="stat-label">迟到</view>
        </view>
        <view class="stat-tile stat-tile-danger">
          <view class="stat-value" style="color:#c04a52">{{item.absent_count}}</view>
          <view class="stat-label">缺勤</view>
        </view>
        <view class="stat-tile">
          <view class="stat-value" style="color:#f97316">{{item.homework_not_submit_count}}</view>
          <view class="stat-label">作业未交</view>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!loading && weekly.length === 0}}" style="padding:36rpx 0">暂无周汇总</view>
  </view>

  <view class="card">
    <view class="card-title">月汇总</view>
    <block wx:for="{{monthly}}" wx:key="index">
      <view class="period-head">{{item.label}}</view>
      <view class="stat-grid">
        <view class="stat-tile stat-tile-warn">
          <view class="stat-value" style="color:#b7791f">{{item.late_count}}</view>
          <view class="stat-label">迟到</view>
        </view>
        <view class="stat-tile stat-tile-danger">
          <view class="stat-value" style="color:#c04a52">{{item.absent_count}}</view>
          <view class="stat-label">缺勤</view>
        </view>
        <view class="stat-tile">
          <view class="stat-value" style="color:#f97316">{{item.homework_not_submit_count}}</view>
          <view class="stat-label">作业未交</view>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!loading && monthly.length === 0}}" style="padding:36rpx 0">暂无月汇总</view>
  </view>

  <view class="card">
    <view class="card-title">学期学分与绩点汇总</view>
    <block wx:for="{{term}}" wx:key="term_code">
      <view class="period-head">{{item.term_code}}</view>
      <view class="row">
        <text class="row-label">挂科门数</text>
        <text class="row-value" style="color:{{item.failed_course_count > 0 ? '#c04a52' : '#3f8a5d'}}">
          {{item.failed_course_count}}
        </text>
      </view>
      <view class="row"><text class="row-label">已修学分</text><text class="row-value">{{item.earned_credits}}</text></view>
      <view class="row"><text class="row-label">要求学分</text><text class="row-value">{{item.required_credits}}</text></view>
      <view class="row"><text class="row-label">平均绩点 GPA</text><text class="row-value">{{item.gpa || '—'}}</text></view>
    </block>
    <view class="empty" wx:if="{{!loading && term.length === 0}}" style="padding:36rpx 0">暂无学期汇总</view>
  </view>

  <view class="hint-text" style="padding:0 12rpx">
    汇总快照由系统定期根据考勤记录与成绩库自动更新，可帮助提前掌握学期学业风险。
  </view>
</view>
