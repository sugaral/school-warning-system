<view class="page">
  <!-- 周汇总 -->
  <view class="card">
    <view class="card-title">周汇总</view>
    <block wx:for="{{weekly}}" wx:key="index">
      <view class="period-head">{{item.label}}</view>
      <view class="stat-grid">
        <view class="stat"><view class="stat-value" style="color:#faad14">{{item.late_count}}</view><view class="stat-label">迟到</view></view>
        <view class="stat"><view class="stat-value" style="color:#f5222d">{{item.absent_count}}</view><view class="stat-label">缺勤</view></view>
        <view class="stat"><view class="stat-value" style="color:#fa8c16">{{item.homework_not_submit_count}}</view><view class="stat-label">作业未交</view></view>
      </view>
    </block>
    <view class="empty" wx:if="{{weekly.length === 0}}" style="padding:40rpx 0">暂无周汇总</view>
  </view>

  <!-- 月汇总 -->
  <view class="card">
    <view class="card-title">月汇总</view>
    <block wx:for="{{monthly}}" wx:key="index">
      <view class="period-head">{{item.label}}</view>
      <view class="stat-grid">
        <view class="stat"><view class="stat-value" style="color:#faad14">{{item.late_count}}</view><view class="stat-label">迟到</view></view>
        <view class="stat"><view class="stat-value" style="color:#f5222d">{{item.absent_count}}</view><view class="stat-label">缺勤</view></view>
        <view class="stat"><view class="stat-value" style="color:#fa8c16">{{item.homework_not_submit_count}}</view><view class="stat-label">作业未交</view></view>
      </view>
    </block>
    <view class="empty" wx:if="{{monthly.length === 0}}" style="padding:40rpx 0">暂无月汇总</view>
  </view>

  <!-- 学期汇总（含学分 / GPA / 挂科） -->
  <view class="card">
    <view class="card-title">学期汇总</view>
    <block wx:for="{{term}}" wx:key="index">
      <view class="period-head">{{item.term_code}}</view>
      <view class="row"><text class="row-label">挂科门数</text><text class="row-value" style="color:{{item.failed_course_count > 0 ? '#f5222d' : '#52c41a'}}">{{item.failed_course_count}}</text></view>
      <view class="row"><text class="row-label">已修学分</text><text class="row-value">{{item.earned_credits}}</text></view>
      <view class="row"><text class="row-label">要求学分</text><text class="row-value">{{item.required_credits}}</text></view>
      <view class="row"><text class="row-label">GPA</text><text class="row-value">{{item.gpa || '—'}}</text></view>
    </block>
    <view class="empty" wx:if="{{term.length === 0}}" style="padding:40rpx 0">暂无学期汇总</view>
  </view>

  <view class="hint" style="color:#8c8c8c;font-size:23rpx;line-height:1.7;padding:0 8rpx 40rpx">
    汇总数据由系统定时任务自动生成（周/月/学期），学分与 GPA 依据成绩库计算。
  </view>
</view>
