.appeal-card {
  padding: 28rpx;
}
.appeal-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.appeal-rel {
  flex: 1;
  font-size: 25rpx;
  font-weight: 600;
  color: #48404b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.appeal-content {
  font-size: 28rpx;
  color: #383139;
  line-height: 1.55;
  margin-bottom: 14rpx;
}
.appeal-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
}
.proof-chip {
  color: #3f8a5d;
  font-weight: 600;
}
.muted-meta {
  color: #8f8896;
}
.note-box {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #edf9f1;
  color: #387b57;
  font-size: 24rpx;
}
