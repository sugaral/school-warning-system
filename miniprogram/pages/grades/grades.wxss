.term-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e4f4ea;
  color: #3f8a5d;
  font-size: 23rpx;
  font-weight: 600;
}
.grade-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(56, 49, 57, 0.07);
}
.grade-row:last-child {
  border-bottom: none;
}
.grade-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #383139;
}
.grade-meta {
  font-size: 22rpx;
  color: #6f6875;
  margin-top: 6rpx;
}
.grade-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.grade-score {
  font-size: 32rpx;
  font-weight: 700;
  color: #383139;
}
