<view class="page">
  <!-- 成绩总览 -->
  <view class="card">
    <view class="card-title">
      <text>学业成绩概览</text>
      <picker mode="selector" range="{{terms}}" value="{{termIndex}}" bindchange="onTermChange" wx:if="{{terms.length > 1}}">
        <view class="term-pill">
          <text>{{terms[termIndex]}}</text>
          <text class="row-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="stat-grid">
      <view class="stat-tile">
        <view class="stat-value">{{stats.total}}</view>
        <view class="stat-label">修读门数</view>
      </view>
      <view class="stat-tile stat-tile-green">
        <view class="stat-value" style="color:#3f8a5d">{{stats.passed}}</view>
        <view class="stat-label">已通过</view>
      </view>
      <view class="stat-tile stat-tile-danger">
        <view class="stat-value" style="color:#c04a52">{{stats.failed}}</view>
        <view class="stat-label">未通过</view>
      </view>
      <view class="stat-tile">
        <view class="stat-value" style="color:#3f8a5d">{{stats.earned_credits}}</view>
        <view class="stat-label">获修学分</view>
      </view>
    </view>
  </view>

  <!-- 成绩列表 -->
  <view class="card" wx:if="{{items.length > 0}}">
    <view class="card-title">课程成绩明细</view>
    <view class="grade-row" wx:for="{{items}}" wx:key="id">
      <view style="flex:1">
        <view class="grade-name">{{item.course_name}}</view>
        <view class="grade-meta">
          {{item.term_code}}{{item.course_code ? ' · ' + item.course_code : ''}} · 学分 {{item.credit || '0'}} · 绩点 {{item.grade_point || '-'}}
        </view>
      </view>
      <view class="grade-right">
        <text class="grade-score">{{item.score || '-'}}</text>
        <text class="tag {{item.passClass}}">{{item.passText}}</text>
      </view>
    </view>
  </view>

  <view class="card empty" wx:else>{{loading ? '正在加载成绩...' : '暂无成绩记录'}}</view>
</view>
