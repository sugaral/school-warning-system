.hint-box {
  background: #f0f5ff;
  border: 1rpx solid #adc6ff;
  border-radius: 10rpx;
  padding: 20rpx;
  color: #2f54eb;
  font-size: 25rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.result {
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.result.ok {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
  color: #52c41a;
}
.result.bad {
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  color: #f5222d;
}
