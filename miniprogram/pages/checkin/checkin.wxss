.hint-clay {
  background: #edf9f1;
  border: 1rpx solid rgba(79, 158, 111, 0.25);
  border-radius: 24rpx;
  padding: 22rpx;
  color: #387b57;
  font-size: 25rpx;
  line-height: 1.65;
  margin-bottom: 14rpx;
}
.result {
  padding: 26rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 18rpx;
}
.result.ok {
  background: #dcf5e6;
  border: 1rpx solid rgba(63, 157, 120, 0.35);
  color: #2f7a53;
}
.result.bad {
  background: #fdecec;
  border: 1rpx solid rgba(192, 74, 82, 0.3);
  color: #c04a52;
}
.card-head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.btn-inline {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
  border-radius: 14rpx;
  background: #f0f7f3;
  color: #3f8a5d;
  border: 1rpx solid rgba(79, 158, 111, 0.3);
  margin: 0;
}
.session-item {
  border: 2rpx solid #ebeaf2;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  margin-top: 14rpx;
  background: #fafbfe;
}
.session-item.active {
  border-color: #4f9e6f;
  background: #f2fbf5;
}
.session-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.session-course {
  font-size: 29rpx;
  font-weight: 700;
  color: #2d2934;
}
.session-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #777080;
}
.session-modes {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.mode-chip {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e6f4ff;
  color: #1677ff;
}
.mode-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.mode-tab {
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  background: #f3f4f8;
  color: #555;
  border: 1rpx solid #e4e6ed;
}
.mode-tab.active {
  background: #4f9e6f;
  color: #fff;
  border-color: #4f9e6f;
  font-weight: 600;
}
.photo-box {
  height: 320rpx;
  border: 2rpx dashed #b7d8c3;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f9fcfa;
  margin-bottom: 18rpx;
}
.photo-preview {
  width: 100%;
  height: 100%;
}
.photo-placeholder {
  color: #6b7280;
  font-size: 26rpx;
}
.gesture-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 12rpx 0 18rpx;
}
.gesture-pad {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  border-radius: 28rpx;
  background: #f6fbf8;
  border: 2rpx solid #d4e8dc;
  overflow: hidden;
}
.gesture-line {
  position: absolute;
  height: 10rpx;
  margin-top: -5rpx;
  background: #4f9e6f;
  border-radius: 999rpx;
  transform-origin: 0 50%;
  pointer-events: none;
  z-index: 1;
}
.gesture-line.live {
  opacity: 0.55;
}
.gesture-dot {
  position: absolute;
  width: 102rpx;
  height: 102rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 3rpx solid #c4dfd0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #4f9e6f;
  z-index: 2;
  box-sizing: border-box;
}
.gesture-dot.active {
  background: #4f9e6f;
  border-color: #3f8a5d;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(79, 158, 111, 0.35);
}
.gesture-dot.multi {
  font-size: 24rpx;
}
.gesture-info {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #555;
  text-align: center;
}
.gesture-actions {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
