.hint-clay {
  background: #edf9f1;
  border: 1rpx solid rgba(79, 158, 111, 0.25);
  border-radius: 24rpx;
  padding: 22rpx;
  color: #387b57;
  font-size: 25rpx;
  line-height: 1.65;
  margin-bottom: 10rpx;
}
.result {
  padding: 26rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 18rpx;
}
.result.ok {
  background: #dcf5e6;
  border: 1rpx solid rgba(63, 157, 120, 0.35);
  color: #2f7a53;
}
.result.bad {
  background: #fdecec;
  border: 1rpx solid rgba(192, 74, 82, 0.3);
  color: #c04a52;
}
