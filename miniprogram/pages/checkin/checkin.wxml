<view class="page">
  <!-- 手动输入课次（无扫码条件时的兜底入口） -->
  <view class="card" wx:if="{{!scanToken}}">
    <view class="card-title">扫码签到</view>
    <view class="hint-box">
      请扫描老师展示的课堂二维码。若扫码不可用，可在下方手动填写课次与口令。
    </view>
    <button class="btn" bindtap="onScan">扫描二维码</button>

    <view class="form-item">
      <text class="form-label form-required">课次 ID</text>
      <input class="form-input" type="number" placeholder="请输入课次 ID" value="{{sessionId}}" bindinput="onSessionInput" />
    </view>
    <view class="form-item">
      <text class="form-label form-required">签到口令</text>
      <input class="form-input" placeholder="二维码中的 scan_token" value="{{manualToken}}" bindinput="onTokenInput" />
    </view>
    <button class="btn btn-ghost" bindtap="onManualSubmit" loading="{{submitting}}">提交签到</button>
  </view>

  <!-- 扫码成功后的确认 -->
  <view class="card" wx:else>
    <view class="card-title">确认签到</view>
    <view class="row"><text class="row-label">课次 ID</text><text class="row-value">{{sessionId}}</text></view>
    <view class="row"><text class="row-label">口令</text><text class="row-value">{{scanToken}}</text></view>
    <button class="btn" bindtap="onConfirm" loading="{{submitting}}">确认签到</button>
    <button class="btn btn-ghost" bindtap="onReset">重新扫描</button>
  </view>

  <!-- 结果 -->
  <view class="card" wx:if="{{result}}">
    <view class="card-title">签到结果</view>
    <view class="result {{result.ok ? 'ok' : 'bad'}}">{{result.message}}</view>
    <view class="row" wx:if="{{result.status}}">
      <text class="row-label">考勤状态</text><text class="row-value">{{result.status}}</text>
    </view>
    <view class="row" wx:if="{{result.time}}">
      <text class="row-label">签到时间</text><text class="row-value">{{result.time}}</text>
    </view>
  </view>

  <view class="hint" style="color:#8c8c8c;font-size:23rpx;line-height:1.7;padding:0 8rpx">
    二维码采用滚动令牌，有效期约 15 分钟；过期后请让老师刷新二维码。
  </view>
</view>
