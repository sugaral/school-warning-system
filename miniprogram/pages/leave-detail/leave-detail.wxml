<view class="page">
  <view class="card" wx:if="{{detail}}">
    <view class="card-title">请假详情</view>
    <view class="row"><text class="row-label">状态</text><text class="row-value">{{detail.status || '-'}}</text></view>
    <view class="row"><text class="row-label">开始日期</text><text class="row-value">{{detail.from_date || '-'}}</text></view>
    <view class="row"><text class="row-label">结束日期</text><text class="row-value">{{detail.to_date || '-'}}</text></view>
    <view class="row"><text class="row-label">请假原因</text><text class="row-value">{{detail.reason || '-'}}</text></view>
    <view class="row"><text class="row-label">审批意见</text><text class="row-value">{{detail.reject_reason || '-'}}</text></view>
    <view class="row"><text class="row-label">提交时间</text><text class="row-value">{{detail.created_at || '-'}}</text></view>
  </view>
  <view class="empty" wx:else>{{loading ? '加载中...' : '记录不存在'}}</view>
</view>
