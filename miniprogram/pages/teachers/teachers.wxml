<view class="page">
  <view class="card card-amber" wx:if="{{unbound}}" bindtap="goBindClass">
    <view class="card-title" style="margin-bottom:6rpx">
      <text style="color:#a16207">您尚未绑定班级</text>
      <text class="tag tag-warn">去绑定</text>
    </view>
    <view class="hint-text" style="margin-top:0">绑定班级后可查看本班班主任与各科授课老师</view>
  </view>

  <view class="card" wx:elif="{{items.length > 0}}">
    <view class="card-title">所属班级教师名录</view>
    <view class="row" wx:for="{{items}}" wx:key="id">
      <view style="flex:1">
        <view class="teacher-name">{{item.name}}</view>
      </view>
      <text class="tag {{item.type === '班主任' ? 'tag-success' : 'tag-info'}}">
        {{item.type || '授课老师'}}
      </text>
    </view>
  </view>

  <view class="card empty" wx:else>{{loading ? '正在加载教师信息...' : '暂无关联教师信息'}}</view>
</view>
