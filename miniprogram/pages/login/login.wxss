.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #4f9e6f 0%, #3f8a5d 31%, #f1f2fa 31%, #f1f2fa 100%);
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.login-hero {
  padding: 104rpx 0 44rpx;
  text-align: center;
  color: #fffdf7;
}

.logo-clay {
  width: 124rpx;
  height: 124rpx;
  line-height: 124rpx;
  margin: 0 auto 22rpx;
  border-radius: 36rpx;
  background: rgba(255, 253, 247, 0.24);
  font-size: 56rpx;
  font-weight: 700;
  box-shadow:
    0 12rpx 28rpx rgba(20, 62, 38, 0.22),
    inset 2rpx 2rpx 6rpx rgba(255, 253, 247, 0.45);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

.login-tabs {
  margin-bottom: 24rpx;
}

.footer {
  text-align: center;
  color: #8f8896;
  font-size: 22rpx;
  padding: 40rpx 0 20rpx;
}
