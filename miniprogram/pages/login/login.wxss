.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #4f9e6f 0%, #3f8a5d 31%, #f1f2fa 31%, #f1f2fa 100%);
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.login-hero {
  padding: 104rpx 0 44rpx;
  text-align: center;
  color: #fffdf7;
}

.logo-clay {
  width: 124rpx;
  height: 124rpx;
  line-height: 124rpx;
  margin: 0 auto 22rpx;
  border-radius: 36rpx;
  background: rgba(255, 253, 247, 0.24);
  font-size: 56rpx;
  font-weight: 700;
  box-shadow:
    0 12rpx 28rpx rgba(20, 62, 38, 0.22),
    inset 2rpx 2rpx 6rpx rgba(255, 253, 247, 0.45);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

.login-tabs {
  margin-bottom: 24rpx;
}

.footer {
  text-align: center;
  color: #8f8896;
  font-size: 22rpx;
  padding: 40rpx 0 20rpx;
}

.net-bar {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  font-size: 22rpx;
  color: #5b5563;
}

.net-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.net-link {
  color: #3f8a5d;
  font-weight: 600;
  flex-shrink: 0;
}

.net-panel {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eceaf2;
}

.net-presets {
  display: flex;
  gap: 12rpx;
}

.btn-mini {
  flex: 1;
  font-size: 22rpx;
  line-height: 52rpx;
  height: 52rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  background: #f2f4f7;
  color: #4b5563;
  border: 1rpx solid #e5e7eb;
}

.btn-mini.active {
  background: #4f9e6f;
  color: #fff;
  border-color: #4f9e6f;
}
