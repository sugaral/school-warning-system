<view class="page">
  <view class="card">
    <view class="form-item">
      <text class="form-label form-required">申诉类型</text>
      <input class="form-input"  placeholder="如：预警申诉" value="{{form.appeal_type}}" bindinput="onInput" data-key="appeal_type" />
    </view>
    <view class="form-item">
      <text class="form-label">关联记录 ID</text>
      <input class="form-input"  placeholder="可选" value="{{form.related_id}}" bindinput="onInput" data-key="related_id" />
    </view>
    <view class="form-item">
      <text class="form-label form-required">申诉内容</text>
      <textarea class="form-textarea" placeholder="请说明申诉理由" value="{{form.content}}" bindinput="onInput" data-key="content" maxlength="500" />
    </view>
    <button class="btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交</button>
  </view>
</view>
