<view class="page">
  <view class="card card-tint">
    <view class="card-title" style="margin-bottom:8rpx">近 7 天考勤与课堂记录</view>
    <view class="hint-text" style="margin-top:0">
      展示每日考勤与作业综合状态；如需补签或请假，可使用下方快捷入口。
    </view>
    <view class="btn-group" style="margin-top:16rpx">
      <button class="btn btn-sm" bindtap="goCheckin">扫码签到</button>
      <button class="btn btn-ghost btn-sm" bindtap="goLeaveForm">发起请假</button>
    </view>
  </view>

  <view class="card" wx:if="{{trend.length > 0}}">
    <view class="att-row" wx:for="{{trend}}" wx:key="index">
      <view>
        <view class="att-date">{{item.full_date || item.date}}</view>
        <view class="att-sub">
          作业：{{item.homeworkText}}{{item.class_behavior === 'disruptive' ? ' · 违纪记录' : ''}}
        </view>
      </view>
      <text class="tag {{item.attendanceClass}}">{{item.attendanceText}}</text>
    </view>
  </view>

  <view class="card empty" wx:else>{{loading ? '加载考勤记录中...' : '暂无近 7 天考勤记录'}}</view>
</view>
