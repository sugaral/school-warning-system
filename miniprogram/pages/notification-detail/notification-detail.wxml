<view class="page">
  <view class="card" wx:if="{{detail}}">
    <view class="card-title">通知详情</view>
    <view class="row"><text class="row-label">标题</text><text class="row-value">{{detail.title || '-'}}</text></view>
    <view class="row"><text class="row-label">内容</text><text class="row-value">{{detail.content || '-'}}</text></view>
    <view class="row"><text class="row-label">发布人</text><text class="row-value">{{detail.publisher_name || '-'}}</text></view>
    <view class="row"><text class="row-label">发布时间</text><text class="row-value">{{detail.created_at || '-'}}</text></view>
  </view>
  <view class="empty" wx:else>{{loading ? '加载中...' : '记录不存在'}}</view>
</view>
