<view class="page">
  <view class="card" wx:if="{{detail}}">
    <view class="detail-head">
      <text class="tag {{detail.typeClass}}">{{detail.type_label || detail.type || '站内消息'}}</text>
      <text class="detail-time">{{detail.createdText}}</text>
    </view>

    <view class="detail-body">{{detail.content || '-'}}</view>
  </view>

  <view class="empty" wx:else>{{loading ? '加载中...' : '消息不存在'}}</view>
</view>
