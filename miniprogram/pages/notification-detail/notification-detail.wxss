.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(56, 49, 57, 0.07);
}
.detail-time {
  font-size: 23rpx;
  color: #8f8896;
}
.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #383139;
  margin-bottom: 14rpx;
}
.detail-meta {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: #8f8896;
  padding-bottom: 18rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(56, 49, 57, 0.07);
}
.detail-body {
  font-size: 29rpx;
  color: #383139;
  line-height: 1.8;
  white-space: pre-wrap;
}
