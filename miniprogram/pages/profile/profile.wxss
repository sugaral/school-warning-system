.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.name { font-size: 36rpx; font-weight: 600; }
.sub { font-size: 25rpx; color: #8c8c8c; margin-top: 8rpx; }
.version { text-align: center; color: #bfbfbf; font-size: 22rpx; padding: 30rpx 0 50rpx; }
