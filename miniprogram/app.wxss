/* ============================================================================
   Claymorphism 绿色软陶主题全局样式（与 admin-frontend clay-theme.css 一致）
   ========================================================================== */
page {
  background-color: #f1f2fa;
  font-size: 28rpx;
  line-height: 1.55;
  color: #383139;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
}

.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 顶部行动栏 / 标题行 */
.page-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.page-heading {
  font-size: 36rpx;
  font-weight: 700;
  color: #383139;
}

.page-sub {
  font-size: 24rpx;
  color: #6f6875;
  margin-top: 4rpx;
}

/* 软陶卡片 */
.card {
  background: #fffdf7;
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(56, 49, 57, 0.06);
  box-shadow:
    0 16rpx 36rpx rgba(56, 49, 57, 0.09),
    inset 3rpx 3rpx 8rpx rgba(255, 253, 247, 0.92),
    inset -4rpx -4rpx 10rpx rgba(56, 49, 57, 0.06);
}

.card-tint {
  background: linear-gradient(145deg, #edf9f1 0%, #ddf1e5 100%);
  border: 1rpx solid rgba(79, 158, 111, 0.16);
}

.card-amber {
  background: linear-gradient(145deg, #fff9ec 0%, #fff1d6 100%);
  border: 1rpx solid rgba(184, 134, 11, 0.22);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #383139;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.card-link {
  font-size: 24rpx;
  font-weight: 600;
  color: #3f8a5d;
}

/* 英雄横幅（主绿色渐变软陶） */
.hero-clay {
  background: linear-gradient(135deg, #4f9e6f 0%, #3f8a5d 60%, #34774f 100%);
  border-radius: 40rpx;
  padding: 36rpx 32rpx;
  color: #fffdf7;
  margin-bottom: 24rpx;
  box-shadow:
    0 20rpx 42rpx rgba(63, 138, 93, 0.26),
    inset 3rpx 3rpx 10rpx rgba(255, 253, 247, 0.35),
    inset -4rpx -4rpx 12rpx rgba(20, 62, 38, 0.24);
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(56, 49, 57, 0.07);
}
.row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}
.row:first-child {
  padding-top: 6rpx;
}
.row-label {
  color: #6f6875;
  font-size: 26rpx;
  flex-shrink: 0;
}
.row-value {
  flex: 1;
  text-align: right;
  color: #383139;
  font-weight: 500;
  word-break: break-all;
}
.row-arrow {
  color: #8f8896;
  font-size: 26rpx;
  margin-left: 6rpx;
}

/* 统计宫格瓷砖 */
.stat-grid {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}
.stat-tile {
  flex: 1;
  background: #f4f8f5;
  border-radius: 26rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  box-shadow:
    inset 2rpx 2rpx 6rpx rgba(255, 253, 247, 0.9),
    inset -2rpx -2rpx 6rpx rgba(56, 49, 57, 0.06);
}
.stat-tile-green {
  background: #e4f4ea;
}
.stat-tile-warn {
  background: #fff7e6;
}
.stat-tile-danger {
  background: #fdf0f1;
}
.stat-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #383139;
  line-height: 1.3;
}
.stat-label {
  font-size: 22rpx;
  color: #6f6875;
  margin-top: 6rpx;
}

/* 预警等级徽标（与 Web 端保持一致） */
.badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #fffdf7;
  box-shadow: 0 4rpx 10rpx rgba(56, 49, 57, 0.14);
}
.badge-yellow { background: #d4a017; }
.badge-orange { background: #f97316; }
.badge-red { background: #c04a52; }
.badge-severe { background: #a8071a; }
.badge-gray { background: #9b95a2; }

/* 状态胶囊标签 */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  background: #e4f4ea;
  color: #3f8a5d;
  border: 1rpx solid rgba(79, 158, 111, 0.25);
  flex-shrink: 0;
}
.tag-success { background: #dcf5e6; color: #2f7a53; border-color: rgba(63, 157, 120, 0.3); }
.tag-warn { background: #fff4df; color: #b7791f; border-color: rgba(212, 160, 23, 0.32); }
.tag-amber { background: #fef7d6; color: #a16207; border-color: rgba(212, 160, 23, 0.35); }
.tag-danger { background: #fdecec; color: #c04a52; border-color: rgba(192, 74, 82, 0.28); }
.tag-info { background: #e8f4ee; color: #387b57; border-color: rgba(79, 158, 111, 0.24); }
.tag-plain { background: #f2f1f7; color: #6f6875; border-color: rgba(56, 49, 57, 0.12); }

/* 软陶胶囊按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  background: linear-gradient(135deg, #52a675 0%, #3f8a5d 100%);
  color: #fffdf7;
  margin-top: 24rpx;
  border: none;
  box-shadow:
    0 12rpx 24rpx rgba(63, 138, 93, 0.24),
    inset 2rpx 2rpx 6rpx rgba(255, 253, 247, 0.38),
    inset -3rpx -3rpx 8rpx rgba(20, 62, 38, 0.2);
}
.btn::after {
  border: none;
}
.btn[disabled] {
  background: #c8d3cd !important;
  color: #fffdf7 !important;
  box-shadow: none;
}
.btn-ghost {
  background: #edf9f1;
  color: #3f8a5d;
  border: 2rpx solid rgba(79, 158, 111, 0.35);
  box-shadow:
    0 8rpx 18rpx rgba(56, 49, 57, 0.08),
    inset 2rpx 2rpx 5rpx rgba(255, 253, 247, 0.9);
}
.btn-danger {
  background: linear-gradient(135deg, #cf5b63 0%, #b53f48 100%);
  box-shadow:
    0 12rpx 24rpx rgba(192, 74, 82, 0.22),
    inset 2rpx 2rpx 6rpx rgba(255, 253, 247, 0.32);
}
.btn-warn {
  background: linear-gradient(135deg, #e5a93b 0%, #c9861d 100%);
  box-shadow:
    0 10rpx 20rpx rgba(201, 134, 29, 0.22),
    inset 2rpx 2rpx 6rpx rgba(255, 253, 247, 0.32);
}
.btn-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  margin: 0;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.btn-group .btn {
  flex: 1;
}

/* 凹陷黏土表单控件 */
.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(56, 49, 57, 0.06);
}
.form-item:last-of-type {
  border-bottom: none;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #48404b;
  margin-bottom: 12rpx;
  display: block;
}
.form-input,
.form-picker {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  color: #383139;
  border: 2rpx solid rgba(79, 158, 111, 0.16);
  border-radius: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f5f9f6;
  box-shadow:
    inset 3rpx 3rpx 6rpx rgba(56, 49, 57, 0.07),
    inset -2rpx -2rpx 5rpx rgba(255, 253, 247, 0.9);
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.form-placeholder {
  color: #9b95a2;
}
.form-textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #383139;
  border: 2rpx solid rgba(79, 158, 111, 0.16);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f5f9f6;
  box-shadow:
    inset 3rpx 3rpx 6rpx rgba(56, 49, 57, 0.07),
    inset -2rpx -2rpx 5rpx rgba(255, 253, 247, 0.9);
}
.form-required::before {
  content: '*';
  color: #c04a52;
  margin-right: 6rpx;
}

/* 验证码输入组合行 */
.code-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}
.code-row .form-input {
  flex: 1;
}
.code-btn {
  flex-shrink: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #e4f4ea;
  color: #3f8a5d;
  border: 2rpx solid rgba(79, 158, 111, 0.3);
}
.code-btn[disabled] {
  background: #ecebf2;
  color: #9b95a2;
  border-color: transparent;
}

/* 分段开关选项卡（黏土胶囊槽） */
.segmented {
  display: flex;
  background: #e6ebe9;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: inset 2rpx 2rpx 6rpx rgba(56, 49, 57, 0.10);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #48404b;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.seg-item.active {
  background: #fffdf7;
  color: #3f8a5d;
  box-shadow:
    0 6rpx 14rpx rgba(56, 49, 57, 0.12),
    inset 2rpx 2rpx 4rpx rgba(255, 253, 247, 0.95);
}
.seg-badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #c04a52;
  color: #fffdf7;
  font-size: 20rpx;
  text-align: center;
}

/* 筛选胶囊栏 */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.filter-item {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #fffdf7;
  color: #48404b;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(56, 49, 57, 0.08);
  box-shadow:
    0 6rpx 14rpx rgba(56, 49, 57, 0.06),
    inset 2rpx 2rpx 4rpx rgba(255, 253, 247, 0.9);
}
.filter-item.active {
  background: linear-gradient(135deg, #4f9e6f 0%, #3f8a5d 100%);
  color: #fffdf7;
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(63, 138, 93, 0.25);
}

/* 提示栏 */
.hint-text {
  font-size: 23rpx;
  color: #6f6875;
  line-height: 1.65;
  margin-top: 12rpx;
}

.error-box {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #fdecec;
  border: 1rpx solid rgba(192, 74, 82, 0.28);
  color: #c04a52;
  font-size: 25rpx;
  line-height: 1.5;
}

/* 空态 & 加载 */
.empty {
  text-align: center;
  color: #8f8896;
  padding: 100rpx 24rpx;
  font-size: 28rpx;
}
.load-more {
  text-align: center;
  color: #6f6875;
  font-size: 24rpx;
  padding: 24rpx 0 40rpx;
}

/* 图片多选九宫格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 16rpx;
}
.image-wrap {
  position: relative;
  width: 176rpx;
  height: 176rpx;
}
.image-item {
  width: 176rpx;
  height: 176rpx;
  border-radius: 22rpx;
  background: #e8efe9;
  box-shadow: 0 6rpx 14rpx rgba(56, 49, 57, 0.08);
}
.image-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  background: #c04a52;
  color: #fffdf7;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 8rpx rgba(56, 49, 57, 0.22);
}
.image-add {
  width: 176rpx;
  height: 176rpx;
  border: 2rpx dashed rgba(79, 158, 111, 0.42);
  border-radius: 22rpx;
  background: #edf9f1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #3f8a5d;
  font-size: 44rpx;
}
.image-add-tip {
  font-size: 20rpx;
  margin-top: 4rpx;
}
