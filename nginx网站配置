# 80: IP 和裸域名统一跳转到 https://www.xueyeyujing.asia
server {
    listen 80;
    server_name 43.255.120.232 xueyeyujing.asia;
    return 301 https://www.xueyeyujing.asia$request_uri;
}

server {
    listen 80;
    server_name www.xueyeyujing.asia;
    return 301 https://www.xueyeyujing.asia$request_uri;
}

# 443: 正式站点
server {
    listen 443 ssl;
    server_name www.xueyeyujing.asia;

    root /www/wwwroot/cursor-x/admin-frontend/dist;
    index index.html;
    client_max_body_size 50m;

    ssl_certificate     /www/server/panel/vhost/cert/www.xueyeyujing.asia/www.xueyeyujing.asia_bundle.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/www.xueyeyujing.asia/www.xueyeyujing.asia.key;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log /www/wwwlogs/www.xueyeyujing.asia.log;
    error_log  /www/wwwlogs/www.xueyeyujing.asia.error.log;

    include /www/server/panel/vhost/nginx/well-known/www.xueyeyujing.asia.conf;

    error_page 404 /404.html;

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env|\.svn|\.project|LICENSE|README.md) {
        return 404;
    }

    location ~ \.well-known {
        allow all;
    }

    if ($uri ~ "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|bak)$") {
        return 403;
    }

    location = / {
        return 302 /login;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location ^~ /files/ {
        proxy_pass http://127.0.0.1:3000/files/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:3000/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /admin/files/ {
        proxy_pass http://127.0.0.1:3000/admin/files/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
